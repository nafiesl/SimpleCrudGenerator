<?php

namespace App\Http\Controllers\Parents;

use fullMstr;
use fullPrnt;
use App\Http\Controllers\Controller;
use Illuminate\Http\Request;
use App\Http\Requests\Masters\CreateRequest;
use App\Http\Requests\Masters\UpdateRequest;

class MasterController extends Controller
{
    public function index(Request $request, Parent $singlePrnt)
    {
        $singleMstrQuery = $singlePrnt->mstrCollections();
        $singleMstrQuery->where('title', 'like', '%'.$request->get('q').'%');
        $singleMstrQuery->orderBy('title');
        $mstrCollections = $singleMstrQuery->paginate(25);

        return view('parents.masters.index', compact('singlePrnt', 'mstrCollections'));
    }

    public function create(Parent $singlePrnt)
    {
        $this->authorize('create', new Master);

        return view('parents.masters.create', compact('singlePrnt'));
    }

    public function store(CreateRequest $singleMstrCreateForm, Parent $singlePrnt)
    {
        $singleMstr = $singleMstrCreateForm->save();

        return redirect()->route('parents.masters.show', [$singlePrnt, $singleMstr]);
    }

    public function show(Parent $singlePrnt, Master $singleMstr)
    {
        return view('parents.masters.show', compact('singlePrnt', 'singleMstr'));
    }

    public function edit(Parent $singlePrnt, Master $singleMstr)
    {
        $this->authorize('update', $singleMstr);

        return view('parents.masters.edit', compact('singlePrnt', 'singleMstr'));
    }

    public function update(UpdateRequest $singleMstrUpdateForm, Parent $singlePrnt, Master $singleMstr)
    {
        $singleMstr->update($singleMstrUpdateForm->validated());

        return redirect()->route('parents.masters.show', [$singlePrnt, $singleMstr]);
    }

    public function destroy(Request $request, Parent $singlePrnt, Master $singleMstr)
    {
        $this->authorize('delete', $singleMstr);

        $request->validate(['master_id' => 'required']);

        if ($request->get('master_id') == $singleMstr->id && $singleMstr->delete()) {
            return redirect()->route('parents.masters.index', $singlePrnt);
        }

        return back();
    }
}
